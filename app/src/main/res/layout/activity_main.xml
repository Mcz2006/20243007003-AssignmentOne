<?xml version="1.0" encoding="utf-8"?>
<!--
    Portrait home screen (Part B).
    Layout strategy: a vertical LinearLayout split by weight (banner / button panel),
    and a 2 x 2 grid built from weighted nested LinearLayouts. Nothing is fixed in
    pixels - every dimension is match_parent, wrap_content or a weight - so the same
    file adapts to any screen size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green"
    android:orientation="vertical">

    <!-- ============ Banner ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="54">

        <ImageView
            android:id="@+id/bannerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_image_description"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_campus" />

        <!-- Dark scrim keeps the white title readable on any photo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/banner_scrim"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/banner_margin"
            android:layout_marginEnd="@dimen/banner_margin"
            android:gravity="center"
            android:shadowColor="@color/banner_shadow"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="@string/banner_title"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ============ Four topic buttons ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="46"
        android:background="@color/green"
        android:orientation="vertical"
        android:padding="@dimen/panel_padding">

        <!-- Row 1: Facilities | Events -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonFacilities"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_green_selector"
                    android:contentDescription="@string/label_facilities"
                    android:onClick="onFacilitiesClick"
                    android:padding="@dimen/button_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_facilities" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:text="@string/label_facilities"
                    android:textColor="@color/white"
                    android:textSize="@dimen/label_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_green_selector"
                    android:contentDescription="@string/label_events"
                    android:onClick="onEventsClick"
                    android:padding="@dimen/button_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_events" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:text="@string/label_events"
                    android:textColor="@color/white"
                    android:textSize="@dimen/label_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Clubs | Support -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonClubs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_green_selector"
                    android:contentDescription="@string/label_clubs"
                    android:onClick="onClubsClick"
                    android:padding="@dimen/button_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_clubs" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:text="@string/label_clubs"
                    android:textColor="@color/white"
                    android:textSize="@dimen/label_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/buttonSupport"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_green_selector"
                    android:contentDescription="@string/label_support"
                    android:onClick="onSupportClick"
                    android:padding="@dimen/button_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_support" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing"
                    android:text="@string/label_support"
                    android:textColor="@color/white"
                    android:textSize="@dimen/label_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
